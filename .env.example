# ═══════════════════════════════════════════════
#  CareCell — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit the actual .env file to git.
# ═══════════════════════════════════════════════

# ── MongoDB ──────────────────────────────────
# For Docker Compose local dev:
MONGO_ROOT_USER=carecell_admin
MONGO_ROOT_PASSWORD=change_this_to_a_strong_password

# For MongoDB Atlas (production), use full URI instead:
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/carecell?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_256_BIT_SECRET

# ── AWS (S3 for health records, SNS for OTP SMS) ──
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_S3_BUCKET=carecell-health-records

# ── Google Maps (Hospital Finder) ────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── WhatsApp Assistant (Meta Cloud API or Twilio) ──
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# ── Mail (optional) ───────────────────────────
# ── Mail (OPTIONAL — leave blank unless you want it) ──
# Primary OTP delivery is SMS via AWS SNS — mail is not required for the app to work.
# Leave these blank and MAIL_HEALTH_ENABLED=false (default) to avoid Actuator
# attempting a live SMTP login on every health check.
# If you DO want mail: Gmail requires an "App Password", not your account password.
# Generate one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HEALTH_ENABLED=false

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://app.carecell.in

# ── Redis ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Server ────────────────────────────────────
PORT=8080
